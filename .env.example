# =============================================================================
# Loan Management System — local development environment
# =============================================================================
# Copy this file to .env (NEVER commit .env), then either edit values manually
# OR run: ./scripts/generate-env.sh
#
# In AWS Workshop Studio you do NOT need this file — the CDK stack provisions
# all secrets in AWS Secrets Manager and ECS task definitions inject them.
# =============================================================================

# --- Application environment ---
APP_ENV=local
LOG_LEVEL=INFO

# --- Database ---
# Generate a strong random password before first run.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__generate_with_openssl_rand_base64_24__
POSTGRES_DB=loandb
DATABASE_URL=postgresql://postgres:__generate_with_openssl_rand_base64_24__@postgresql:5432/loandb

# --- Redis ---
# REDIS_PASSWORD is optional locally. Setting it enables AUTH on the local
# redis container. In AWS the AUTH token is generated by CDK and injected.
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# --- JWT ---
# Generate with: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=__generate_with_openssl_rand_base64_64__
JWT_ALGORITHM=HS256
JWT_ISSUER=loan-management-system
JWT_AUDIENCE=loan-management-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# Comma-separated list of allowed origins. For local docker-compose include
# the Vite dev server (5173) and the nginx gateway (8000).
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173,http://localhost:3000

# --- Demo / workshop toggles ---
# ENABLE_DEMO_SEED=true seeds a single admin user on first boot with the
# fixed credential documented in README "Sign in with the demo
# credentials" (admin / Admin12345!). The seed upserts on every restart,
# so the documented password is always the active one. Disable for
# production-like environments.
ENABLE_DEMO_SEED=false

# --- Chaos / DevOps Agent integration ---
# Enable the /applications/stress-test endpoint (admin-only) for the
# "DevOps Agent investigates CPU saturation" workshop scenario.
ALLOW_STRESS_TEST=false

# DevOps Agent webhook (optional integration). If you don't use this, leave blank.
WEBHOOK_URL=
WEBHOOK_SECRET=

# --- Service tuning (rarely changed) ---
AUTO_DEBIT_SUCCESS_RATE=0.9
REMINDER_DAYS=3
OVERDUE_NOTICE_DAYS=7
LEGAL_NOTICE_DAYS=15
EMAIL_SIMULATION=true
